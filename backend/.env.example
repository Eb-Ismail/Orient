# ORIENT-GR - Configuration d'environnement Backend Next.js
PORT=5000
NODE_ENV=development

# Sécurité & Authentification JWT
JWT_SECRET=super_secret_orient_gr_gendarmerie_key_2026_jwt_token_secure
JWT_EXPIRES_IN=24h

# Microsoft SQL Server (T-SQL)
# Mode Windows Authentication recommandé (sans mot de passe dans .env)
DB_AUTH_MODE=windows
DB_SERVER=.\CLASS
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_NAME=OrientGR_DB
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Option SQL Server Authentication (uniquement si DB_AUTH_MODE=sql)
# DB_USER=
# DB_PASSWORD=
# DB_PORT=1433

# Mode Mock Fallback (false en production SQL Server réelle)
ENABLE_DB_MOCK_FALLBACK=false

# Service IA d'Orientation (Optionnel : si renseigné, utilise Gemini 1.5 Flash pour l'entretien IA ; sinon le moteur NLP trilingue local est actif à 100%)
# GEMINI_API_KEY=votre_cle_api_gemini_ici

# Frontend URL pour CORS
FRONTEND_URL=http://localhost:3000

# Architecture IA à deux modèles : Texte + Voice
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=gemma4:12b

MOULSOT_BASE_URL=http://localhost:7200/v1
MOULSOT_VOICE_MODEL=atlasia/moulsot.v0.3
